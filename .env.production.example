# ECS 上的 .env.production；复制后填入真实值。
DATABASE_URL=postgresql://user:password@host:5432/blog
BETTER_AUTH_URL=https://blog.example.com
BETTER_AUTH_SECRET=replace-with-a-random-secret
NEXT_PUBLIC_SITE_URL=https://blog.example.com

# 管理中心提交文章直接调用 GitHub Contents API
# fine-grained PAT，只授权 your-github-username/blog 的 Contents: Read and write
GITHUB_CONTENT_TOKEN=github_pat_xxx
GITHUB_CONTENT_OWNER=your-github-username
GITHUB_CONTENT_REPO=blog
GITHUB_CONTENT_BRANCH=main

# DeepSeek / OpenAI-compatible API
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
