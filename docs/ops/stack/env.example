# 服务器 /opt/blog/.env —— docker compose 的变量插值文件。
# 复制成 .env 后填真实值，权限 chmod 600。

# ---- 镜像 ----
# 现在是在 ECS 上本地构建，镜像名固定；上 ACR/CI 后改这三行即可，compose 不用动。
BLOG_IMAGE=blog:local
# BLOG_IMAGE=registry.cn-hangzhou.aliyuncs.com/xuexi/blog:latest

# ---- 数据库 ----
# 只用字母数字，避免 URL 里出现需要转义的字符。
POSTGRES_USER=app
POSTGRES_PASSWORD=请执行 openssl rand -hex 16 生成
