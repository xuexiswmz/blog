# 服务器 /opt/blog/.env —— docker compose 的变量插值文件。
# 复制成 .env 后 chmod 600。

# ---- 镜像 ----
# 注意用 -vpc 的内网地址（ECS 同地域同 VPC，不走公网流量）。
BLOG_IMAGE=crpi-00qum4psb3e9ho6w-vpc.cn-beijing.personal.cr.aliyuncs.com/xuexiswmz_blog/blog:latest

# 如果内网地址拉不到（报 manifest unknown），改成公网地址：
# BLOG_IMAGE=crpi-00qum4psb3e9ho6w.cn-beijing.personal.cr.aliyuncs.com/xuexiswmz_blog/blog:latest

# ---- 数据库 ----
# 只用字母数字，避免 URL 里出现需要转义的字符。
POSTGRES_USER=app
POSTGRES_PASSWORD=请执行 openssl rand -hex 16 生成
