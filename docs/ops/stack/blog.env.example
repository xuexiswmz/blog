# 服务器 /opt/stack/blog.env —— 对应原仓库的 .env.production
# 注意：DATABASE_URL 会被 docker-compose.yml 里的同名变量覆盖，这里写不写都行。
DATABASE_URL=postgresql://app:密码@postgres:5432/blog
BETTER_AUTH_URL=https://xuexiswmz.cn
BETTER_AUTH_SECRET=换成 32 位以上随机串
NEXT_PUBLIC_SITE_URL=https://xuexiswmz.cn

# 管理中心提交文章：直接调用 GitHub Contents API
GITHUB_CONTENT_TOKEN=github_pat_xxx
GITHUB_CONTENT_OWNER=xuexiswmz
GITHUB_CONTENT_REPO=blog
GITHUB_CONTENT_BRANCH=main

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
